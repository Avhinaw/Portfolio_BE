# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the app (nginx/Caddy = 1). 0 = none.
# Wrong values break per-IP rate limiting. See README.
TRUST_PROXY=0

# ---- MongoDB ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_calls

# ---- CORS / URLs -----------------------------------------------------------
# Comma-separated list of EXACT browser origins (scheme + host [+ port]). https only in production.
FRONTEND_ORIGINS=http://localhost:5173
HOST_DASHBOARD_URL=http://localhost:5173/host
PUBLIC_API_URL=http://localhost:3000

# ---- Host authentication ---------------------------------------------------
# Generate with:  openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-48-xxxxxxxx
# Access token lifetime: 1m..24h (e.g. 30m, 4h)
JWT_ACCESS_TTL=4h
HOST_EMAIL=you@example.com
# Generate with:  echo -n "your long password" | npm run hash-password --silent
# Keep the SINGLE QUOTES (the hash contains '$').
HOST_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE$REPLACE'

# ---- Telegram (optional but recommended) -----------------------------------
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates . Never expose these to the frontend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=8000
NOTIFY_MAX_ATTEMPTS=6
NOTIFY_RETRY_BASE_SECONDS=5
NOTIFY_POLL_INTERVAL_MS=5000

# ---- Meeting lifecycle -----------------------------------------------------
MEETING_REQUEST_TTL_SECONDS=300
ACCEPTED_START_TIMEOUT_SECONDS=120
MEETING_DURATION_LIMIT_SECONDS=1800
RECONNECT_GRACE_SECONDS=30
MAX_ACTIVE_CALLS=1
MAX_PENDING_REQUESTS=20
MAX_PENDING_PER_VISITOR=1
MEETING_RETENTION_DAYS=30
SWEEP_INTERVAL_MS=5000
HOST_DEFAULT_AVAILABLE=true

# ---- WebRTC ICE servers ----------------------------------------------------
# Comma-separated. coturn also answers STUN, so point both at your own server.
STUN_URLS=
# e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URL=
# Preferred: shared secret => short-lived credentials (coturn use-auth-secret).
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# Alternative: one static long-term credential (only if TURN_SHARED_SECRET is empty).
TURN_USERNAME=
TURN_PASSWORD=

# ---- Rate limits -----------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=300
HOST_API_RATE_LIMIT_PER_MINUTE=120
MEETING_CREATE_RATE_LIMIT_MAX=5
MEETING_CREATE_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
SOCKET_EVENT_LIMIT_PER_10S=200

# ---- docker-compose only ---------------------------------------------------
# Use letters/digits only (they are placed inside a connection URL).
MONGO_ROOT_USER=portfolio
MONGO_ROOT_PASSWORD=ReplaceWithLongRandomAlphanumeric
# Public IP of the VPS (coturn external-ip). Required for the "turn" profile.
TURN_EXTERNAL_IP=
TURN_REALM=turn.example.com
